# Public app URL used for auth redirects and CSRF origin checks
NEXT_PUBLIC_APP_URL=

# Supabase (dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte base64 key used to encrypt wallet seeds at rest (server only)
WALLET_ENCRYPTION_KEY=

# Server-side pepper for claim-code hashes (server only)
CLAIM_CODE_PEPPER=

# Shared secret for the escrow expiry/refund cron endpoint
CRON_SECRET=

# Google Gemini (server only)
GEMINI_API_KEY=

# XRPL testnet configuration
XRPL_TESTNET_URL=wss://s.altnet.rippletest.net:51233
XRPL_EXPLORER_URL=https://testnet.xrpl.org

# Self-issued testnet issuers (addresses are public, seeds are server only)
XRPL_ISSUER_USD_ADDRESS=
XRPL_ISSUER_USD_SEED=
XRPL_ISSUER_INR_ADDRESS=
XRPL_ISSUER_INR_SEED=
XRPL_ISSUER_EUR_ADDRESS=
XRPL_ISSUER_EUR_SEED=
XRPL_ISSUER_NGN_ADDRESS=
XRPL_ISSUER_NGN_SEED=
